{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noEmit": true, "skipLibCheck": true, "types": ["node"],
    "allowImportingTsExtensions": true, "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["*.ts"]
}
